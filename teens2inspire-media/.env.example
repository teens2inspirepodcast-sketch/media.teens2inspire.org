# Public Supabase client configuration (same Supabase project as teens2inspire.org)
NEXT_PUBLIC_SUPABASE_URL=https://mphswidvmesdkefkgwjz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MARKETING_URL=https://teens2inspire.org
NEXT_PUBLIC_MEDIA_URL=https://media.teens2inspire.org

# Cloudflare R2 server-only credentials. Never prefix secrets with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Private bucket is used for member audio/video uploads and signed playback.
# R2_BUCKET_NAME is retained as a fallback for existing deployments.
R2_PRIVATE_BUCKET_NAME=
R2_BUCKET_NAME=

# Optional public bucket for future public assets; current app code does not use it.
R2_PUBLIC_BUCKET_NAME=

# Stripe checkout and webhook secrets are read by Supabase Edge Functions, not this app.
# Configure STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID_PERSONAL,
# and STRIPE_PRICE_ID_FAMILY in Supabase Edge Function secrets, not here.

# Public base URL for the public R2 bucket, e.g. https://cdn.example.org
R2_PUBLIC_BASE_URL=
R2_PUBLIC_BUCKET_NAME=teens2inspire-public
